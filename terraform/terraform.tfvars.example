# Copy to terraform.tfvars and edit. terraform.tfvars is git-ignored.
# In the terraform workflow these come from TF_VAR_* environment variables.
aws_region        = "eu-west-1"
github_repository = "your-github-user/your-repo"

# ./bootstrap creates the GitHub OIDC provider, so this stays false.
# create_github_oidc_provider = false
